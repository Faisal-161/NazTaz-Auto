# Commerce data source: mock | shopify
COMMERCE_PROVIDER=mock

# Mock adapter tuning (dev only)
MOCK_LATENCY_MS=0          # artificial latency per call, e.g. 300 to see skeletons
MOCK_ERROR_RATE=0          # 0..1 probability a mock call throws, to exercise error states

# Public site URL (canonical links later; Phase 3)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2: Shopify (unused until COMMERCE_PROVIDER=shopify) ---
SHOPIFY_STORE_DOMAIN=            # your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=  # e.g. 2026-10
SHOPIFY_STOREFRONT_PUBLIC_TOKEN= # public Storefront token (safe client-side)
SHOPIFY_STOREFRONT_PRIVATE_TOKEN= # private Storefront token (server only)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_URL=
SHOPIFY_REVALIDATION_SECRET=     # webhook -> revalidateTag
