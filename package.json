{
  "name": "brand-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "playwright test --project=shots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze:size": "node scripts/route-size.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9"
  }
}
